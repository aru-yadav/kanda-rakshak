# Copy to .env (gitignored)
DB_PATH=../data/kanda.db
DEVICE_TOKEN=change-me-same-as-firmware-secrets
ADMIN_TOKEN=change-me-admin

# data.gov.in — Current Daily Price of Various Commodities from Various Markets (Mandi)
DATAGOV_API_KEY=
DATAGOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
PRICE_STATE=Maharashtra
PRICE_COMMODITY=Onion
PRICE_MARKETS=Lasalgaon,Lasalgaon(Niphad),Pimpalgaon,Niphad,Nashik,Pune
# Used ONLY if API and cache both fail. Shown on screen as "fallback".
PRICE_FALLBACK_MODAL=
PRICE_FALLBACK_MARKET=Lasalgaon

# Notifications (demo channel = Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_VOICE=true
NOTIFY_MIN_INTERVAL_S=3600

# Demo: dashboard can control simulated SIM-* sheds (digital twin). Never affects real devices.
DEMO_MODE=true
# Only these devices send phone notifications (avoid flooding during multi-shed demos). Empty = all.
NOTIFY_DEVICES=SIM-NSK-01,KR-01
